<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Pazapa Maths – 6e – Semaine 1 Séance 3</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet"/>
<style>
:root{--bg:#ffffff;--surface:#ffffff;--border:#e8e4d9;--yellow:#f5c518;--green:#8dc63f;--blue:#3ab5d8;--pink:#f28b82;--orange:#f5a623;--text:#1a1d23;--muted:#8a8f9a;--radius:16px;}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
body{background:#fff;color:var(--text);font-family:'Syne',sans-serif;min-height:100vh;display:flex;flex-direction:column;align-items:center;padding:2rem 1rem 4rem;}
header{text-align:center;margin-bottom:1.5rem;}
.badge{display:inline-flex;align-items:center;gap:.4rem;background:var(--yellow);color:#000;font-size:.72rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;padding:.28rem .85rem;border-radius:99px;margin-bottom:.8rem;}
.dot{width:8px;height:8px;border-radius:50%;display:inline-block;}
h1{font-size:clamp(1.4rem,3.5vw,2rem);font-weight:800;line-height:1.2;color:var(--text);}
h1 .gl{color:var(--green);}h1 .bl{color:var(--blue);}
.sub{font-family:'JetBrains Mono',monospace;font-size:.8rem;color:var(--muted);margin-top:.3rem;margin-bottom:1.6rem;}
.prog-wrap{width:100%;max-width:660px;margin-bottom:1.2rem;}
.prog-info{display:flex;justify-content:space-between;font-size:.75rem;font-family:'JetBrains Mono',monospace;color:var(--muted);margin-bottom:.35rem;}
.bar-bg{background:var(--border);border-radius:99px;height:7px;overflow:hidden;}
.bar-fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--green));border-radius:99px;transition:width .5s;}
.chips{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1.5rem;}
.chip{display:flex;align-items:center;gap:.35rem;padding:.28rem .7rem;border-radius:99px;font-size:.75rem;font-family:'JetBrains Mono',monospace;border:1.5px solid var(--border);background:#fff;font-weight:600;color:var(--text);}
.chip .cd{width:8px;height:8px;border-radius:50%;}
.card{width:100%;max-width:660px;background:#fff;border:2px solid var(--border);border-radius:var(--radius);padding:1.8rem 1.8rem 1.4rem;position:relative;box-shadow:0 4px 24px rgba(0,0,0,.06);}
.stripe{position:absolute;top:0;left:0;right:0;height:4px;border-radius:var(--radius) var(--radius) 0 0;background:linear-gradient(90deg,var(--yellow),var(--orange),var(--pink),var(--blue),var(--green));}
.qnum{font-size:.7rem;font-family:'JetBrains Mono',monospace;color:var(--muted);margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.08em;}
.eq{font-size:clamp(1.05rem,2.2vw,1.35rem);font-weight:800;color:var(--green);margin-bottom:.5rem;line-height:1.3;}
.qtxt{font-size:.88rem;color:var(--muted);margin-bottom:1rem;}
.qtxt b{color:var(--orange);font-family:'JetBrains Mono',monospace;}
/* Inputs interactifs */
.sub-inputs{display:flex;flex-direction:column;gap:.5rem;margin-bottom:.6rem;}
.sub-row{display:flex;align-items:center;gap:.5rem;font-family:'JetBrains Mono',monospace;font-size:.88rem;flex-wrap:wrap;}
.sub-row .slbl{min-width:230px;color:var(--text);font-size:.86rem;font-weight:600;}
.sub-row .slbl small{color:var(--muted);font-weight:400;display:block;font-size:.74rem;margin-top:.1rem;}
.sub-input{width:110px;background:#f7f6f2;border:2px solid var(--border);border-radius:8px;color:var(--text);font-family:'JetBrains Mono',monospace;font-size:.95rem;padding:.38rem .7rem;outline:none;transition:border-color .2s;text-align:center;}
.sub-input:focus{border-color:var(--blue);}
.sub-input.ok{border-color:var(--green);background:#f0faeb;color:#3a7d0a;}
.sub-input.ko{border-color:var(--pink);background:#fff0ef;color:#c0392b;}
.sub-input-long{width:100%;max-width:300px;background:#f7f6f2;border:2px solid var(--border);border-radius:8px;color:var(--text);font-family:'JetBrains Mono',monospace;font-size:.84rem;padding:.38rem .7rem;outline:none;transition:border-color .2s;}
.sub-input-long:focus{border-color:var(--blue);}
.sub-input-long.ok{border-color:var(--green);background:#f0faeb;color:#3a7d0a;}
.sub-input-long.ko{border-color:var(--pink);background:#fff0ef;color:#c0392b;}
.btn{display:inline-flex;align-items:center;gap:.35rem;padding:.48rem 1.1rem;border-radius:99px;font-family:'Syne',sans-serif;font-size:.85rem;font-weight:700;cursor:pointer;border:none;transition:transform .12s;}
.btn:active{transform:scale(.96);}
.btn:disabled{opacity:.35;cursor:default;}
.btn-p{background:var(--blue);color:#fff;box-shadow:0 3px 10px rgba(58,181,216,.25);}
.btn-h{background:var(--yellow);color:#5a3e00;}
.btn-g{background:transparent;color:var(--muted);border:2px solid var(--border);}
.fb{margin-top:.9rem;padding:.65rem .9rem;border-radius:10px;font-size:.86rem;display:none;align-items:flex-start;gap:.5rem;line-height:1.5;}
.fb.show{display:flex;}
.fb.ok{background:#f0faeb;border:1.5px solid var(--green);color:#3a7d0a;}
.fb.ko{background:#fff0ef;border:1.5px solid var(--pink);color:#c0392b;}
.fb-det{font-family:'JetBrains Mono',monospace;font-size:.76rem;color:var(--text);margin-top:.2rem;}
.hint-box{margin-top:.8rem;background:#fffbeb;border:1.5px dashed var(--yellow);border-radius:10px;padding:.65rem .9rem;font-size:.82rem;color:#7a6010;display:none;line-height:1.6;}
.hint-box.show{display:block;}
.hint-box strong{color:var(--orange);}
.nav{display:flex;justify-content:space-between;margin-top:1.2rem;gap:.5rem;}
.results{width:100%;max-width:660px;text-align:center;display:none;}
.results.show{display:block;}
.results-card{background:#fff;border:2px solid var(--border);border-radius:var(--radius);padding:2.2rem 1.8rem;box-shadow:0 4px 24px rgba(0,0,0,.06);}
.score{font-size:clamp(2.5rem,8vw,4.5rem);font-weight:800;line-height:1;margin:.6rem 0 .3rem;color:var(--blue);}
.stars{font-size:1.8rem;margin:.3rem 0 .8rem;}
.rmsg{color:var(--muted);font-size:.9rem;margin-bottom:1.8rem;}
.recap{text-align:left;display:flex;flex-direction:column;gap:.4rem;margin-bottom:1.8rem;}
.ritem{display:flex;align-items:center;gap:.6rem;padding:.5rem .9rem;background:#f7f6f2;border:1.5px solid var(--border);border-radius:10px;font-family:'JetBrains Mono',monospace;font-size:.78rem;color:var(--text);}
.ritem.ok-i{border-color:#b5e08a;}
.ritem.ko-i{border-color:#f9c0bb;}
.ritem .re{color:var(--blue);flex:1;}
</style>
</head>
<body>
<header>
  <div class="badge">
    <span class="dot" style="background:#f5c518"></span>
    <span class="dot" style="background:#8dc63f"></span>
    <span class="dot" style="background:#3ab5d8"></span>
    Pazapa · Maths · 6e
  </div>
  <div style="font-family:'JetBrains Mono',monospace;font-size:.73rem;color:#8a8f9a;margin-bottom:.35rem;letter-spacing:.06em;">Semaine 1 – Séance 3</div>
  <h1>Somme, <span class="gl">différence</span> et <span class="bl">produit</span></h1>
  <p class="sub">3 exercices · niveau 6ème</p>
</header>

<div class="prog-wrap">
  <div class="prog-info"><span id="prog-lbl">Exercice 1 / 3</span><span id="prog-pct">0 %</span></div>
  <div class="bar-bg"><div class="bar-fill" id="prog-bar" style="width:0%"></div></div>
</div>
<div class="chips">
  <div class="chip"><div class="cd" style="background:#8dc63f"></div><span id="cnt-ok">0</span> correctes</div>
  <div class="chip"><div class="cd" style="background:#f28b82"></div><span id="cnt-ko">0</span> erreurs</div>
  <div class="chip"><div class="cd" style="background:#8a8f9a"></div><span id="cnt-rem">3</span> restantes</div>
</div>

<div class="card" id="ex-card">
  <div class="stripe"></div>
  <div class="qnum" id="q-num">Exercice 1</div>
  <div class="eq" id="q-eq"></div>
  <div class="qtxt" id="q-txt"></div>
  <div id="q-body"></div>
  <div class="hint-box" id="hint-box"></div>
  <div class="fb" id="feedback"><span id="fb-icon" style="font-size:1.1rem;flex-shrink:0"></span><div><div id="fb-msg"></div><div class="fb-det" id="fb-det"></div></div></div>
  <div class="nav">
    <button class="btn btn-g" id="btn-prev" onclick="prevQ()">← Précédent</button>
    <div style="display:flex;gap:.5rem;">
      <button class="btn btn-h" id="btn-hint" onclick="toggleHint()">? Indice</button>
      <button class="btn btn-p" id="btn-next" onclick="nextQ()" disabled>Suivant →</button>
    </div>
  </div>
</div>

<div class="results" id="results-screen">
  <div class="results-card">
    <div class="badge" style="margin-bottom:.5rem">
      <span class="dot" style="background:#f5c518"></span>
      <span class="dot" style="background:#8dc63f"></span>
      <span class="dot" style="background:#3ab5d8"></span>
      Résultats
    </div>
    <div class="score"><span id="score-num">0</span>/3</div>
    <div class="stars" id="stars-row"></div>
    <div class="rmsg" id="results-msg"></div>
    <div class="recap" id="recap-list"></div>
    <button class="btn btn-p" onclick="restart()" style="margin:0 auto;display:flex;">🔄 Recommencer</button>
  </div>
</div>

<script>
// ============================================================
//  Semaine 1 – Séance 3 : Somme, différence, produit
//  Contenu mathématique vérifié :
//   Ex2 : 1324+4132=5456 | 250x40=10000 | 179-45=134
//   Ex3 : 999+93=1092 | 564-101=463 | 1896-999=897
//          5471x1000=5471000 | 524x11=5764 | 43x21=903
// ============================================================
const EXS = [
  {
    title: '1. Compléter avec : la somme · la différence · le produit · termes · facteurs',
    txt: 'Complète chaque phrase avec le bon vocabulaire.',
    items: [
      { lbl: 'a) 24 \u2212 15 est…', sub: 'la … entre les … 24 et 15 (deux réponses séparées par /)', key: 'la difference / termes', accept: ['la difference/termes','difference/termes','la difference / les termes','difference / termes'] },
      { lbl: 'b) 24 \u00D7 15 est…', sub: 'le … des … 24 et 15 (deux réponses séparées par /)', key: 'le produit / facteurs', accept: ['le produit/facteurs','produit/facteurs','le produit / les facteurs','produit / facteurs'] },
      { lbl: 'c) 24 + 15 est…', sub: 'la … des … 24 et 15 (deux réponses séparées par /)', key: 'la somme / termes', accept: ['la somme/termes','somme/termes','la somme / les termes','somme / termes'] },
    ],
    inputClass: 'sub-input-long',
    hint: '<strong>Astuce :</strong> une soustraction donne <strong>la différence</strong> et ses nombres sont des <strong>termes</strong> ; une addition donne <strong>la somme</strong> (termes aussi) ; une multiplication donne <strong>le produit</strong> et ses nombres sont des <strong>facteurs</strong>.'
  },
  {
    title: '2. Calculer',
    txt: 'Effectue chaque calcul.',
    items: [
      { lbl: 'a) la somme de 1 324 et 4 132', sub: '1 324 + 4 132 = ?', key: '5456' },
      { lbl: 'b) le produit de 250 par 40', sub: '250 \u00D7 40 = ?', key: '10000' },
      { lbl: 'c) la différence entre 179 et 45', sub: '179 \u2212 45 = ?', key: '134' },
    ],
    inputClass: 'sub-input',
    hint: '<strong>Astuce :</strong> « somme » = on additionne, « produit » = on multiplie, « différence » = on soustrait. Pour 250 × 40, calcule 25 × 4 = 100 puis ajoute les zéros → 10 000.'
  },
  {
    title: '3. Calculer le plus rapidement possible',
    txt: 'Utilise des astuces de calcul mental.',
    items: [
      { lbl: 'a) 999 + 93',     sub: '999 + 93 = ?',     key: '1092' },
      { lbl: 'b) 564 \u2212 101', sub: '564 \u2212 101 = ?', key: '463' },
      { lbl: 'c) 1896 \u2212 999', sub: '1896 \u2212 999 = ?', key: '897' },
      { lbl: 'd) 5471 \u00D7 1000', sub: '5471 \u00D7 1000 = ?', key: '5471000' },
      { lbl: 'e) 524 \u00D7 11',  sub: '524 \u00D7 11 = ?',  key: '5764' },
      { lbl: 'f) 43 \u00D7 21',   sub: '43 \u00D7 21 = ?',   key: '903' },
    ],
    inputClass: 'sub-input',
    hint: '<strong>Astuce :</strong> 999 + 93 = 1000 + 93 \u2212 1. Pour \u2212 101, enlève 100 puis 1. Pour \u2212 999, enlève 1000 puis rajoute 1. \u00D7 1000 : ajoute trois zéros. \u00D7 11 : (\u00D7 10) + (\u00D7 1). \u00D7 21 : (\u00D7 20) + (\u00D7 1).'
  },
];

// Les 3 exercices comptent pour le score
const INTERACTIVE_IDX = [0, 1, 2];
const TOTAL = INTERACTIVE_IDX.length;

let cur = 0, answered = [false, false, false], hintOpen = false;
const $ = id => document.getElementById(id);

function norm(s) {
  return s.trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/['\u2019]/g, "'").replace(/\s+/g, ' ');
}

// Vérifie une réponse : clé exacte normalisée OU variante acceptée
function isCorrect(item, val) {
  const n = norm(val);
  if (n === norm(item.key)) return true;
  if (item.accept) return item.accept.some(a => norm(a) === n);
  return false;
}

function renderQ() {
  const ex = EXS[cur];
  $('q-num').textContent = `Exercice ${cur + 1}`;
  $('q-eq').textContent = ex.title;
  $('q-txt').textContent = ex.txt;
  $('hint-box').classList.remove('show'); $('hint-box').innerHTML = ''; hintOpen = false;
  $('feedback').className = 'fb';
  $('btn-prev').disabled = cur === 0;
  $('btn-hint').style.display = ex.hint ? '' : 'none';
  $('btn-next').textContent = cur === EXS.length - 1 ? 'Terminer →' : 'Suivant →';
  $('btn-next').disabled = !answered[cur];

  const body = $('q-body'); body.innerHTML = '';
  const wrap = document.createElement('div'); wrap.className = 'sub-inputs';
  ex.items.forEach((item, i) => {
    const row = document.createElement('div'); row.className = 'sub-row';
    const sp = document.createElement('span'); sp.className = 'slbl';
    sp.textContent = item.lbl;
    if (item.sub) { const sm = document.createElement('small'); sm.textContent = item.sub; sp.appendChild(sm); }
    const inp = document.createElement('input'); inp.type = 'text';
    inp.className = ex.inputClass; inp.placeholder = '…'; inp.id = `si${i}`; inp.autocomplete = 'off';
    inp.addEventListener('keydown', e => { if (e.key === 'Enter') { const bc = $('btn-check'); if (bc && !bc.disabled) checkMulti(); } });
    row.appendChild(sp); row.appendChild(inp); wrap.appendChild(row);
  });
  const br = document.createElement('div'); br.style.cssText = 'display:flex;gap:.5rem;margin-top:.7rem;';
  const bv = document.createElement('button'); bv.className = 'btn btn-p'; bv.id = 'btn-check'; bv.textContent = 'Valider ✓'; bv.onclick = checkMulti;
  br.appendChild(bv); body.appendChild(wrap); body.appendChild(br);

  if (answered[cur] && ex._ans) {
    bv.disabled = true;
    ex.items.forEach((item, i) => {
      const inp = $(`si${i}`); if (!inp) return;
      inp.value = ex._ans[i];
      inp.className = ex.inputClass + ' ' + (isCorrect(item, ex._ans[i]) ? 'ok' : 'ko');
      inp.disabled = true;
    });
    showFB();
  }
  updateStats();
}

function checkMulti() {
  const ex = EXS[cur];
  ex._ans = ex.items.map((_, i) => ($(`si${i}`) || { value: '' }).value);
  answered[cur] = true;
  ex.items.forEach((item, i) => {
    const inp = $(`si${i}`); if (!inp) return;
    inp.className = ex.inputClass + ' ' + (isCorrect(item, ex._ans[i]) ? 'ok' : 'ko');
    inp.disabled = true;
  });
  const bc = $('btn-check'); if (bc) bc.disabled = true;
  showFB(); $('btn-next').disabled = false; updateStats();
}

function showFB() {
  const ex = EXS[cur]; if (!ex._ans) return;
  const allOk = ex.items.every((item, i) => isCorrect(item, ex._ans[i]));
  $('feedback').className = 'fb show ' + (allOk ? 'ok' : 'ko');
  $('fb-icon').textContent = allOk ? '✅' : '❌';
  $('fb-msg').textContent = allOk ? 'Parfait !' : 'Pas tout à fait…';
  const wrong = ex.items.filter((item, i) => !isCorrect(item, ex._ans[i]));
  $('fb-det').textContent = allOk ? 'Toutes les réponses sont correctes !' : 'Correction : ' + wrong.map(w => w.lbl + ' → ' + w.key).join('  |  ');
}

function toggleHint() {
  const h = $('hint-box'); hintOpen = !hintOpen;
  if (hintOpen) { h.innerHTML = EXS[cur].hint; h.classList.add('show'); } else h.classList.remove('show');
}

function updateStats() {
  const done = answered.filter(Boolean).length;
  $('prog-bar').style.width = Math.round(done / TOTAL * 100) + '%';
  $('prog-lbl').textContent = `Exercice ${cur + 1} / ${TOTAL}`;
  $('prog-pct').textContent = Math.round(done / TOTAL * 100) + ' %';
  let ok = 0, ko = 0;
  INTERACTIVE_IDX.forEach(i => {
    const ex = EXS[i];
    if (!answered[i] || !ex._ans) return;
    if (ex.items.every((item, j) => isCorrect(item, ex._ans[j]))) ok++; else ko++;
  });
  $('cnt-ok').textContent = ok;
  $('cnt-ko').textContent = ko;
  $('cnt-rem').textContent = INTERACTIVE_IDX.filter(i => !answered[i] || !EXS[i]._ans).length;
}

function nextQ() {
  if (cur < EXS.length - 1) { cur++; renderQ(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
  else showResults();
}
function prevQ() { if (cur > 0) { cur--; renderQ(); window.scrollTo({ top: 0, behavior: 'smooth' }); } }

function showResults() {
  $('ex-card').style.display = 'none'; $('results-screen').classList.add('show');
  let ok = 0;
  INTERACTIVE_IDX.forEach(i => {
    const ex = EXS[i];
    if (answered[i] && ex._ans && ex.items.every((item, j) => isCorrect(item, ex._ans[j]))) ok++;
  });
  $('score-num').textContent = ok;
  const filled = ok === 3 ? 5 : ok === 2 ? 4 : ok === 1 ? 2 : 0;
  $('stars-row').textContent = '⭐'.repeat(filled) + '☆'.repeat(5 - filled);
  const msgs = ['Continue à t\'entraîner !', 'Bon début, persévère !', 'Bien joué !', 'Parfait ! 🎉'];
  $('results-msg').textContent = msgs[ok];
  const list = $('recap-list'); list.innerHTML = '';
  INTERACTIVE_IDX.forEach(i => {
    const ex = EXS[i];
    const allOk = answered[i] && ex._ans && ex.items.every((item, j) => isCorrect(item, ex._ans[j]));
    const d = document.createElement('div'); d.className = 'ritem ' + (allOk ? 'ok-i' : 'ko-i');
    d.innerHTML = `<span>${allOk ? '✅' : '❌'}</span><span class="re"></span>`;
    d.querySelector('.re').textContent = ex.title;
    list.appendChild(d);
  });
}

function restart() {
  cur = 0; answered = [false, false, false];
  EXS.forEach(ex => { delete ex._ans; });
  $('ex-card').style.display = 'block'; $('results-screen').classList.remove('show');
  renderQ();
}

renderQ();
</script>
</body>
</html>
