<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Pazapa · 5e · Semaine 7 Jour 3 · Les Portes du Temple</title>
<style>
/* ============ JETONS DE DESIGN — Les Portes du Temple (galerie souterraine bronze / émeraude) ============ */
:root{
  --stone:#e4ded0;
  --stone-mid:#b9ae95;
  --stone-dark:#8f8268;
  --bronze:#8a5a2b;
  --bronze-dark:#5c3b1c;
  --sand:#c9a15f;
  --emerald:#2f7d5f;
  --emerald-light:#5fae8c;
  --gold:#e8b84b;
  --gold-bright:#ffce5c;
  --ink:#2c2417;
  --muted:#7c7259;
  --success:#2f7d5f;
  --success-bg:#e5f2ea;
  --danger:#a1442c;
  --danger-bg:#f8e6e0;
  --info:#3f6f8f;
  --info-bg:#e6f0f7;
  --radius:18px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer;appearance:none;-webkit-appearance:none;text-align:inherit;}
html{scroll-behavior:auto;}
body{
  min-height:100vh;font-family:Arial,Helvetica,sans-serif;color:var(--stone);
  background:
    radial-gradient(ellipse 520px 620px at 50% -8%, rgba(232,184,75,.22), transparent 62%),
    radial-gradient(ellipse 460px 340px at 100% 100%, rgba(47,125,95,.20), transparent 60%),
    linear-gradient(180deg,#241f16,#332c1e 45%,#3a3324 100%);
  overflow-x:hidden;position:relative;padding-bottom:3rem;
}
body::before{content:'';position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.35;
  background-image:repeating-linear-gradient(90deg, rgba(0,0,0,.10) 0 2px, transparent 2px 70px);}
@media (prefers-reduced-motion: reduce){ *{animation-duration:.001ms !important;transition-duration:.001ms !important;} }

.hud{position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:1rem;
  padding:.8rem 1.2rem;background:linear-gradient(180deg, rgba(36,31,22,.97), rgba(36,31,22,.88));
  border-bottom:2px solid var(--bronze-dark);backdrop-filter:blur(3px);flex-wrap:wrap;}
.hud-title{display:flex;align-items:center;gap:.55rem;font-family:Georgia,'Times New Roman',serif;font-weight:700;font-size:1.02rem;color:var(--gold-bright);}
.hud-mid{font-family:'Courier New',Consolas,monospace;font-size:.78rem;color:var(--sand);text-align:center;letter-spacing:.03em;}
.hud-right{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;}
.hud-timer{font-family:'Courier New',Consolas,monospace;font-size:.85rem;font-weight:700;color:var(--gold-bright);
  background:rgba(232,184,75,.14);border:1.5px solid var(--bronze);border-radius:8px;
  padding:.4rem .7rem;min-width:4.6em;text-align:center;letter-spacing:.03em;}
.btn-sound{background:none;border:1.5px solid var(--bronze);color:var(--stone);border-radius:10px;
  padding:.4rem .7rem;font-size:.9rem;cursor:pointer;min-height:2.6rem;font-family:'Courier New',Consolas,monospace;}
.btn-sound:hover{border-color:var(--gold);}
.btn-sound[aria-pressed="true"]{border-color:var(--gold);color:var(--gold-bright);}
.btn-sound:focus-visible,.btn:focus-visible,.opt-btn:focus-visible,.field:focus-visible,.just-btn:focus-visible,.sum-btn:focus-visible{
  outline:3px solid var(--emerald-light);outline-offset:2px;}

.doors-row{display:flex;justify-content:center;gap:1.6rem;margin:1.4rem 0 .4rem;position:relative;z-index:1;}
.door-slot{display:flex;flex-direction:column;align-items:center;gap:.35rem;}
.door-slot svg{width:46px;height:56px;filter:drop-shadow(0 3px 6px rgba(0,0,0,.4));}
.door-slot .door-shape{fill:var(--stone-dark);stroke:var(--bronze-dark);stroke-width:2;transition:fill .5s ease;}
.door-slot.done .door-shape{fill:var(--gold);}
.door-slot .d-label{font-family:'Courier New',Consolas,monospace;font-size:.7rem;color:var(--sand);}

.stage{max-width:820px;margin:0 auto;padding:.4rem 1.2rem 0;position:relative;z-index:1;}
.scene{display:none;}
.scene.show{display:block;animation:fadeUp .45s ease both;}
@keyframes fadeUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}

.intro-card{background:linear-gradient(180deg, rgba(58,51,36,.92), rgba(36,31,22,.92));
  border:2px solid var(--bronze-dark);border-radius:var(--radius);padding:2.1rem 2rem;text-align:center;
  box-shadow:0 10px 34px rgba(0,0,0,.35);}
.intro-eyebrow{font-family:'Courier New',Consolas,monospace;font-size:.76rem;letter-spacing:.16em;text-transform:uppercase;color:var(--emerald-light);margin-bottom:.5rem;}
.intro-card h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(1.4rem,3.6vw,2rem);color:var(--gold-bright);margin-bottom:.3rem;line-height:1.3;}
.intro-text{max-width:540px;margin:0 auto 1.5rem;line-height:1.85;font-size:1rem;text-align:left;color:var(--stone);}
.intro-text p{margin-bottom:.85rem;}
.intro-text .quote{border-left:3px solid var(--gold);padding:.6rem 1rem;background:rgba(232,184,75,.12);border-radius:6px;color:var(--gold-bright);font-weight:700;}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.72rem 1.45rem;border-radius:12px;border:none;cursor:pointer;
  font-family:Arial,Helvetica,sans-serif;font-weight:800;font-size:1rem;min-height:2.7rem;transition:transform .12s ease, box-shadow .15s ease;}
.btn:active{transform:scale(.96);}
.btn-emerald{background:linear-gradient(135deg,var(--emerald-light),var(--emerald));color:#f4fff9;box-shadow:0 4px 14px rgba(47,125,95,.4);}
.btn-emerald:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(47,125,95,.5);}
.btn-ghost{background:transparent;border:2px solid var(--bronze);color:var(--stone);}
.btn-ghost:hover{border-color:var(--gold);}
.btn-continue{background:transparent;border:2px dashed var(--info);color:var(--info);}
.btn-continue:hover{background:var(--info-bg);color:#1c3a4d;}
.btn:disabled{opacity:.4;cursor:not-allowed;}

.epreuve-card{background:#2c2617;border:2px solid var(--bronze-dark);border-radius:var(--radius);
  padding:1.7rem 1.6rem;box-shadow:0 8px 28px rgba(0,0,0,.3);}
.epreuve-eyebrow{font-family:'Courier New',Consolas,monospace;font-size:.72rem;letter-spacing:.13em;text-transform:uppercase;color:var(--emerald-light);margin-bottom:.3rem;}
.epreuve-card h2{font-family:Georgia,'Times New Roman',serif;color:var(--gold-bright);font-size:1.22rem;margin-bottom:.7rem;line-height:1.3;}
.epreuve-consigne{font-weight:800;font-size:.96rem;color:var(--stone);margin-bottom:1rem;line-height:1.75;
  background:rgba(47,125,95,.12);border-left:4px solid var(--emerald);border-radius:8px;padding:.7rem .9rem;}
.epreuve-substep{font-size:.78rem;font-family:'Courier New',Consolas,monospace;color:var(--sand);margin-bottom:.6rem;}
.epreuve-subq{font-weight:700;font-size:.92rem;color:var(--gold-bright);margin:.9rem 0 .5rem;}

.fig-wrap{position:relative;width:100%;max-width:560px;margin:0 auto 1rem;background:#f3ead4;border:1.5px solid var(--bronze);border-radius:12px;overflow:hidden;}
.fig-wrap svg{display:block;width:100%;height:auto;}

.choice-row{display:flex;gap:.7rem;flex-wrap:wrap;margin-bottom:1rem;}
.opt-btn{padding:.7rem 1.3rem;border-radius:10px;border:2.5px solid var(--bronze);background:#332c1e;color:var(--stone);
  font-weight:700;font-size:.95rem;cursor:pointer;min-height:2.7rem;transition:border-color .15s,background .2s;}
.opt-btn:hover:not(:disabled){border-color:var(--gold);}
.opt-btn.selected{border-color:var(--gold);background:rgba(232,184,75,.18);color:var(--gold-bright);}
.opt-btn.correct{border-color:var(--success);background:var(--success-bg);color:var(--success);}
.opt-btn.wrong{border-color:var(--danger);background:var(--danger-bg);color:var(--danger);animation:shake .35s ease;}
.opt-btn:disabled{cursor:not-allowed;}
@keyframes shake{0%,100%{transform:translateX(0);}25%{transform:translateX(-4px);}75%{transform:translateX(4px);}}

.field-row{display:flex;align-items:center;gap:.6rem;margin-bottom:1rem;flex-wrap:wrap;}
.field{width:96px;height:2.6rem;border:2px solid var(--bronze);border-radius:8px;text-align:center;
  font-size:1.05rem;font-weight:700;font-family:'Courier New',Consolas,monospace;color:var(--ink);background:#fff9ec;outline:none;transition:border-color .15s;}
.field:focus{border-color:var(--gold);}
.field.f-ok{border-color:var(--success);background:var(--success-bg);}
.field.f-ko{border-color:var(--danger);background:var(--danger-bg);}
.field:disabled{opacity:1;}
.unit{font-size:.9rem;color:var(--sand);font-family:'Courier New',Consolas,monospace;}

.just-list{display:flex;flex-direction:column;gap:.6rem;margin-bottom:1rem;}
.just-btn{display:flex;align-items:flex-start;gap:.7rem;background:#332c1e;border:2.5px solid var(--bronze);
  border-radius:10px;padding:.65rem .9rem;cursor:pointer;min-height:2.7rem;text-align:left;transition:border-color .15s,background .2s;}
.just-btn:hover:not(:disabled){border-color:var(--gold);}
.just-btn .jb-letter{font-family:'Courier New',Consolas,monospace;font-weight:800;color:var(--sand);flex-shrink:0;}
.just-btn .jb-txt{font-size:.9rem;color:var(--stone);line-height:1.6;}
.just-btn.selected{border-color:var(--gold);background:rgba(232,184,75,.14);}
.just-btn.correct{border-color:var(--success);background:var(--success-bg);}
.just-btn.correct .jb-txt,.just-btn.correct .jb-letter{color:#1c3d2c;}
.just-btn.wrong{border-color:var(--danger);background:var(--danger-bg);animation:shake .35s ease;}
.just-btn.wrong .jb-txt,.just-btn.wrong .jb-letter{color:#5c2416;}
.just-btn:disabled{cursor:not-allowed;}

.actions-row{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;margin-top:.4rem;}
.hint-box{margin-top:.7rem;background:rgba(232,184,75,.13);border:1.5px dashed var(--gold);border-radius:10px;
  padding:.65rem .9rem;font-size:.85rem;color:var(--gold-bright);display:none;line-height:1.8;}
.hint-box.show{display:block;}
.hint-note{font-size:.8rem;color:var(--gold-bright);font-family:'Courier New',Consolas,monospace;display:none;align-items:center;gap:.3rem;}
.hint-note.show{display:inline-flex;}
.corr-box{margin-top:.7rem;background:var(--info-bg);border:1.5px solid var(--info);border-radius:10px;
  padding:.7rem .95rem;font-size:.86rem;color:#1c3a4d;display:none;line-height:1.9;}
.corr-box.show{display:block;}
.corr-box strong{color:var(--info);}
.feedback{margin-top:.8rem;padding:.7rem .95rem;border-radius:10px;font-size:.9rem;line-height:1.8;display:none;}
.feedback.show{display:block;}
.feedback.ok{background:var(--success-bg);border:1.5px solid var(--success);color:#1c3d2c;}
.feedback.ko{background:var(--danger-bg);border:1.5px solid var(--danger);color:#5c2416;}
.feedback.warn{background:rgba(232,184,75,.15);border:1.5px solid var(--gold);color:var(--ink);}
.feedback.info{background:var(--info-bg);border:1.5px solid var(--info);color:#1c3a4d;}

.chrono-wrap{display:none;align-items:center;gap:.9rem;margin-top:1rem;padding:.7rem 1rem;
  border:2px solid var(--gold);border-radius:12px;background:rgba(232,184,75,.14);}
.chrono-wrap.show{display:flex;}
.chrono-num{font-family:'Courier New',Consolas,monospace;font-size:1.5rem;font-weight:800;color:var(--gold-bright);min-width:2.3rem;text-align:center;flex-shrink:0;}
.chrono-body{flex:1;min-width:0;}
.chrono-label{font-family:'Courier New',Consolas,monospace;font-size:.78rem;color:var(--gold-bright);margin-bottom:.35rem;}
.chrono-track{height:9px;border-radius:99px;background:var(--bronze-dark);overflow:hidden;}
.chrono-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--gold),var(--gold-bright));width:100%;transition:width 1s linear;}

.plates-row{display:flex;justify-content:center;gap:.6rem;margin-bottom:1rem;align-items:center;}
.plate{width:30px;height:30px;border-radius:8px;background:var(--stone-dark);border:2px solid var(--bronze-dark);transition:background .5s ease,box-shadow .5s ease;}
.plate.lit{background:var(--gold);box-shadow:0 0 10px var(--gold);}
.seal{width:38px;height:38px;border-radius:50%;background:var(--stone-dark);border:2.5px solid var(--bronze-dark);
  display:flex;align-items:center;justify-content:center;font-size:1.1rem;transition:background .6s ease,box-shadow .6s ease;}
.seal.lit{background:var(--gold);box-shadow:0 0 14px var(--gold-bright);}

.sum-zone{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;justify-content:center;min-height:3.4rem;
  border:2px dashed var(--bronze);border-radius:12px;padding:.7rem;margin-bottom:.8rem;background:#332c1e;}
.sum-chip{padding:.5rem 1rem;border-radius:8px;background:var(--gold);color:#3a2a0a;font-weight:800;
  font-family:'Courier New',Consolas,monospace;font-size:1rem;}
.sum-btn{padding:.6rem 1.1rem;border-radius:10px;border:2.5px solid var(--bronze);background:#332c1e;color:var(--stone);
  font-weight:800;font-family:'Courier New',Consolas,monospace;cursor:pointer;min-height:2.7rem;}
.sum-btn:hover:not(:disabled){border-color:var(--gold);}
.sum-btn:disabled{opacity:.35;cursor:not-allowed;}
.sum-result{font-family:'Courier New',Consolas,monospace;font-size:1.1rem;font-weight:800;color:var(--gold-bright);text-align:center;margin-top:.6rem;display:none;}
.sum-result.show{display:block;}

.finale-wrap{position:relative;text-align:center;padding:1.6rem 1rem 2rem;}
.sanctuary-glow{width:100%;max-width:420px;height:8px;margin:0 auto 1.2rem;border-radius:99px;
  background:linear-gradient(90deg,transparent,var(--gold-bright),transparent);opacity:.8;}
.doors{position:relative;width:min(400px,82vw);height:220px;margin:0 auto 1.5rem;overflow:hidden;border-radius:14px;
  border:2px solid var(--bronze-dark);background:#241f16;}
.door-half{position:absolute;top:0;bottom:0;width:52%;background:linear-gradient(180deg,#8a5a2b,#5c3b1c);
  border:2px solid var(--bronze-dark);transition:transform 1.4s cubic-bezier(.6,0,.3,1);}
.door-half.l{left:-1%;border-radius:14px 0 0 14px;}
.door-half.r{right:-1%;border-radius:0 14px 14px 0;}
.doors.open .door-half.l{transform:translateX(-100%);}
.doors.open .door-half.r{transform:translateX(100%);}
.door-light{position:absolute;inset:0;background:radial-gradient(circle, rgba(255,214,110,.95), rgba(47,125,95,.25) 55%, transparent 75%);
  opacity:0;transition:opacity 1s ease .6s;}
.doors.open .door-light{opacity:1;}
.finale-title{font-family:Georgia,'Times New Roman',serif;color:var(--gold-bright);font-size:1.3rem;font-weight:700;margin-bottom:.6rem;}
.finale-sub{font-size:1rem;color:var(--stone);margin-bottom:1rem;max-width:520px;margin-left:auto;margin-right:auto;line-height:1.8;}
.finale-time{display:inline-flex;align-items:center;gap:.5rem;font-family:'Courier New',Consolas,monospace;
  font-size:1rem;font-weight:700;color:var(--gold-bright);background:rgba(232,184,75,.16);
  border:1.5px solid var(--gold);border-radius:99px;padding:.5rem 1.1rem;margin-bottom:1.2rem;}
.finale-encourage{max-width:540px;margin:0 auto 1.6rem;background:rgba(232,184,75,.1);border:1.5px solid var(--gold);
  border-radius:12px;padding:.9rem 1.2rem;font-size:.94rem;line-height:1.85;color:var(--gold-bright);}
.corrections-panel{display:none;text-align:left;max-width:620px;margin:0 auto 1.4rem;background:var(--info-bg);
  border:1.5px solid var(--info);border-radius:12px;padding:1rem 1.2rem;}
.corrections-panel.show{display:block;}
.corrections-panel h3{font-family:Georgia,serif;color:var(--info);font-size:1rem;margin-bottom:.7rem;}
.corr-item{font-size:.86rem;line-height:1.85;margin-bottom:.8rem;color:#1c3a4d;}
.corr-item .st{font-weight:800;margin-right:.3rem;}

@media(max-width:480px){
  .epreuve-card{padding:1.2rem 1.1rem;}
  .btn{font-size:.85rem;padding:.55rem 1rem;}
}
</style>
</head>
<body>

<div class="hud">
  <div class="hud-title">🏛 Les Portes du Temple</div>
  <div class="hud-mid">Pazapa · 5e · Semaine 7 · Jour 3</div>
  <div class="hud-right">
    <div class="hud-timer" id="hud-timer" role="status" aria-live="off" aria-label="Chronomètre du défi">⏱ 00:00</div>
    <button class="btn-sound" id="btn-sound" onclick="toggleSound()" aria-pressed="true" aria-label="Activer ou couper le son">🔊 Son activé</button>
  </div>
</div>

<div class="doors-row" id="doors-row"><!-- injecté en JS --></div>

<div class="stage">

  <section class="scene show" id="scene-intro">
    <div class="intro-card">
      <div class="intro-eyebrow">Je relève le défi · angles et parallélisme</div>
      <h1>🏛 Les Portes du Temple</h1>
      <div class="intro-text">
        <p class="quote">🏛 Les bâtisseurs du temple protégeaient leurs salles secrètes grâce aux propriétés des angles.</p>
        <p>Trois portes se dressent devant toi.</p>
        <p>Pour les ouvrir, tu devras résoudre trois énigmes géométriques.</p>
      </div>
      <button class="btn btn-emerald" onclick="startGame()">▶ Commencer le défi</button>
    </div>
  </section>

  <section class="scene" id="scene-epreuve">
    <div class="epreuve-card" id="epreuve-card"><!-- injecté en JS --></div>
  </section>

  <section class="scene" id="scene-finale">
    <div class="finale-wrap">
      <div class="sanctuary-glow"></div>
      <div class="doors" id="doors">
        <div class="door-light"></div>
        <div class="door-half l"></div>
