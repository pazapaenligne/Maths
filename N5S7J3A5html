window.toggleHint=function(n){
  playHint();
  var box=$('hint-'+n);
  box.classList.toggle('show');
  if(box.classList.contains('show')){
    if(n===1) e1_hintSeen=true;
    else if(n===2) e2_hintSeen=true;
    else if(n===3){ e3_hintSeen[e3_order[e3_step]]=true; }
  }
  if(n===1) checkE1Ready(); else if(n===2) checkE2Ready(); else if(n===3) checkE3Ready();
};

function onEpreuveDone(n){
  solved[n-1]=true;
  playDoor();
  openDoorIcon(n);
  if(n<3){
    var btn=$('btn-valider'); if(btn) btn.disabled=true;
    var hb=$('btn-hint'); if(hb) hb.style.display='none';
    var cb=$('btn-continue'); if(cb) cb.style.display='none';
    startChrono(5000, 'Porte suivante', function(){ if(n===1) renderE2(); else renderE3(); });
  } else {
    startChrono(5000, 'Ouverture du sanctuaire', function(){ triggerFinale(); });
  }
}

