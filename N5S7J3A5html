function chronoBlock(label){
  return '<div class="chrono-wrap" id="chrono-wrap"><span class="chrono-num" id="chrono-num">5</span>'
    +'<div class="chrono-body"><div class="chrono-label" id="chrono-label">⏱ '+(label||'Étape suivante')+' dans quelques secondes…</div>'
    +'<div class="chrono-track"><div class="chrono-fill" id="chrono-fill"></div></div>'
    +'<div class="actions-row"><button type="button" class="btn btn-ghost" id="chrono-skip" onclick="skipChrono()">▶ Continuer maintenant</button></div>'
    +'</div></div>';
}
function startChrono(durationMs,label,onDone){
  var wrap=$('chrono-wrap'),fill=$('chrono-fill'),lab=$('chrono-label'),num=$('chrono-num');
  window.__chronoFired=false;
  window.__chronoOnDone=onDone;
  if(!wrap){ if(!window.__chronoFired){window.__chronoFired=true; onDone && onDone();} return; }
  wrap.classList.add('show');
  var remaining=Math.ceil(durationMs/1000);
  num.textContent=remaining; lab.textContent='⏱ '+(label||'Étape suivante')+' dans '+remaining+' s';
  fill.style.transition='none'; fill.style.width='100%';
  requestAnimationFrame(function(){ fill.style.transition='width '+durationMs+'ms linear'; fill.style.width='0%'; });
  setTimeout(function(){ scrollIntoViewSmart(wrap); },50);
  clearInterval(window.__chronoInterval);
  window.__chronoInterval=setInterval(function(){
    remaining--;
    if(remaining<=0){ clearInterval(window.__chronoInterval); num.textContent='0'; lab.textContent='⏱ '+(label||'Étape suivante')+'…'; }
    else { num.textContent=remaining; lab.textContent='⏱ '+(label||'Étape suivante')+' dans '+remaining+' s'; }
  },1000);
  clearTimeout(window.__chronoTimeout);
  window.__chronoTimeout=setTimeout(function(){
    clearInterval(window.__chronoInterval);
    if(!window.__chronoFired){ window.__chronoFired=true; onDone && onDone(); }
  },durationMs);
}
function clearChronoTimers(){ clearInterval(window.__chronoInterval); clearTimeout(window.__chronoTimeout); }
window.skipChrono=function(){
  clearChronoTimers();
  if(!window.__chronoFired){
    window.__chronoFired=true;
    var fn=window.__chronoOnDone;
    if(fn) fn();
  }
};

