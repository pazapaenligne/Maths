function parseStrict(str){
  if(str==null) return NaN;
  var s=String(str).trim().replace(/\s+/g,'').replace('°','').replace(',', '.');
  if(!/^-?\d+(\.\d+)?$/.test(s)) return NaN;
  return parseFloat(s);
}

