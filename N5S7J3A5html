  var labels=['Porte 1 — Les gardiens des lignes','Porte 2 — Le mécanisme oublié','Porte 3 — Le sanctuaire des quatre angles'];
  var html='<h3>📖 Corrections des trois portes</h3>';
  for(var i=1;i<=3;i++){
    var st = solved[i-1] ? (correctionShown[i-1] ? '<span class="st" style="color:var(--info)">ℹ️</span>' : '<span class="st" style="color:var(--success)">✅</span>') : '<span class="st" style="color:var(--danger)">—</span>';
    html+='<div class="corr-item">'+st+'<strong>'+labels[i-1]+'</strong><br>'+CORR[i]+'</div>';
  }
  p.innerHTML=html; p.classList.add('show');
};

/* ==================================================================
   RECOMMENCER
   ================================================================== */
window.restart=function(){
  clearChronoTimers();
  current=1; attempts=[0,0,0]; solved=[false,false,false]; correctionShown=[false,false,false];
  e1_selected=null; e1_selectedJust=null; e2_selectedJust=null;
  e1_hintSeen=false; e2_hintSeen=false; e3_hintSeen={A:false,B:false,C:false,D:false,E:false};
  e3_step=0; e3_revealed=[]; e3_attempts={A:0,B:0,C:0,D:0,E:0}; e3_selectedJust=null;
  shuffle(E1_JUSTS); shuffle(E2_JUSTS);
  Object.keys(E3Q).forEach(function(k){ shuffle(E3Q[k].justs); });
  renderDoors();
  $('doors').classList.remove('open');
  $('corrections-panel').classList.remove('show');
  resetGameTimer();
  showScene('scene-intro');
};

document.addEventListener('DOMContentLoaded', function(){ renderDoors(); });
})();
</script>
