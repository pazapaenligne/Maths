      <div class="finale-sub">Les trois mécanismes du temple ont livré leurs secrets.</div>
      <div class="finale-time" id="finale-time">⏱ Temps total : 00:00</div>
      <div class="finale-encourage">🏛️ <strong>Bravo pour ta persévérance !</strong> Chaque raisonnement juste t'a permis d'avancer un peu plus loin dans le temple.</div>
      <div class="corrections-panel" id="corrections-panel"></div>
      <div class="actions-row" style="justify-content:center">
        <button class="btn btn-emerald" onclick="restart()">↻ Recommencer le défi</button>
        <button class="btn btn-ghost" onclick="toggleCorrections()">📖 Revoir les corrections</button>
      </div>
    </div>
  </section>

</div>

<script>
(function(){
'use strict';
var $=function(id){return document.getElementById(id);};
function shuffle(arr){ for(var i=arr.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=arr[i];arr[i]=arr[j];arr[j]=t;} return arr; }
var REDUCED_MOTION = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
function scrollTopSmart(){ window.scrollTo({top:0,behavior:REDUCED_MOTION?'auto':'smooth'}); }
function scrollIntoViewSmart(el){ if(el) el.scrollIntoView({behavior:REDUCED_MOTION?'auto':'smooth',block:'nearest'}); }

/* ==================================================================
   GÉOMÉTRIE — helpers réutilisables (arcs d'angle, chevrons, intersections)
   ================================================================== */
function mid(p1,p2){ return {x:(p1.x+p2.x)/2,y:(p1.y+p2.y)/2}; }
function lineIntersect(p1,p2,p3,p4){
  var x1=p1.x,y1=p1.y,x2=p2.x,y2=p2.y,x3=p3.x,y3=p3.y,x4=p4.x,y4=p4.y;
  var d=(x1-x2)*(y3-y4)-(y1-y2)*(x3-x4);
  if(Math.abs(d)<1e-6) return {x:(x1+x3)/2,y:(y1+y3)/2};
  var t=((x1-x3)*(y3-y4)-(y1-y3)*(x3-x4))/d;
  return {x:x1+t*(x2-x1), y:y1+t*(y2-y1)};
}
function angleArcPts(vertex,pA,pB,r){
  var dAx=pA.x-vertex.x, dAy=pA.y-vertex.y, dA=Math.sqrt(dAx*dAx+dAy*dAy)||1;
  var dBx=pB.x-vertex.x, dBy=pB.y-vertex.y, dB=Math.sqrt(dBx*dBx+dBy*dBy)||1;
  var uAx=dAx/dA,uAy=dAy/dA,uBx=dBx/dB,uBy=dBy/dB;
  var a0=Math.atan2(uAy,uAx), a1=Math.atan2(uBy,uBx);
  var diff=a1-a0;
  while(diff<=-Math.PI) diff+=2*Math.PI;
  while(diff>Math.PI) diff-=2*Math.PI;
  var sweep=diff>0?1:0;
  var x0=vertex.x+r*Math.cos(a0), y0=vertex.y+r*Math.sin(a0);
  var x1=vertex.x+r*Math.cos(a0+diff), y1=vertex.y+r*Math.sin(a0+diff);
  return 'M'+x0.toFixed(1)+','+y0.toFixed(1)+' A'+r+','+r+' 0 0 '+sweep+' '+x1.toFixed(1)+','+y1.toFixed(1);
}
function angleLabelPos(vertex,pA,pB,r,extra){
  var dAx=pA.x-vertex.x, dAy=pA.y-vertex.y, dA=Math.sqrt(dAx*dAx+dAy*dAy)||1;
  var dBx=pB.x-vertex.x, dBy=pB.y-vertex.y, dB=Math.sqrt(dBx*dBx+dBy*dBy)||1;
  var ux=dAx/dA+dBx/dB, uy=dAy/dA+dBy/dB, ud=Math.sqrt(ux*ux+uy*uy)||1;
  return {x:vertex.x+(r+(extra||16))*ux/ud, y:vertex.y+(r+(extra||16))*uy/ud};
}
function chevronMark(p1,p2,color){
  var m=mid(p1,p2);
  var dx=p2.x-p1.x, dy=p2.y-p1.y, d=Math.sqrt(dx*dx+dy*dy)||1;
  var ux=dx/d, uy=dy/d, px=-uy, py=ux, len=10, wing=6;
  var tipX=m.x+ux*len/2, tipY=m.y+uy*len/2;
  var backX=m.x-ux*len/2, backY=m.y-uy*len/2;
  var w1x=backX+px*wing, w1y=backY+py*wing;
  var w2x=backX-px*wing, w2y=backY-py*wing;
  return '<path d="M'+w1x.toFixed(1)+','+w1y.toFixed(1)+' L'+tipX.toFixed(1)+','+tipY.toFixed(1)+' L'+w2x.toFixed(1)+','+w2y.toFixed(1)+
    '" fill="none" stroke="'+color+'" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>';
}
function angleTag(vertex,pA,pB,r,label,color,dashed){
  var lp=angleLabelPos(vertex,pA,pB,r,18);
  return '<path d="'+angleArcPts(vertex,pA,pB,r)+'" fill="none" stroke="'+color+'" stroke-width="2.4"'+(dashed?' stroke-dasharray="4 3"':'')+'/>'
    +'<text x="'+lp.x.toFixed(1)+'" y="'+lp.y.toFixed(1)+'" font-family="Georgia,serif" font-weight="700" font-size="16" fill="'+color+'" text-anchor="middle">'+label+'</text>';
}

